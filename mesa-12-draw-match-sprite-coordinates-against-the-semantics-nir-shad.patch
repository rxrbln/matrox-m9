From 9733d9fcd7ecf62101f6cda83641a83647729b46 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Sat, 3 Oct 2026 07:34:16 +0200
Subject: [PATCH] draw: match sprite coordinates against the semantics NIR
 shaders were scanned with
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

draw scans NIR fragment shaders with TEXCOORD semantics regardless of the
screen's tgsi_texcoord cap, while the wide-point stage looked for the cap's
semantic.  On a screen without tgsi_texcoord (parhelia) no coordinate was
ever replaced, the expanded sprite had no texture coordinate and the driver
dropped it: arb_point_sprite-checkerboard and -mipmap drew nothing.

Copyright 2026 René Rebe <rene@exactco.de>

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 src/gallium/auxiliary/draw/draw_pipe_wide_point.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/gallium/auxiliary/draw/draw_pipe_wide_point.c b/src/gallium/auxiliary/draw/draw_pipe_wide_point.c
index 7000309..c5a7715 100644
--- a/src/gallium/auxiliary/draw/draw_pipe_wide_point.c
+++ b/src/gallium/auxiliary/draw/draw_pipe_wide_point.c
@@ -240,6 +240,10 @@ widepoint_first_point(struct draw_stage *stage,
       const struct draw_fragment_shader *fs = draw->fs.fragment_shader;
 
       assert(fs);
+      /* draw scans NIR shaders with TEXCOORD semantics whatever the screen. */
+      const enum tgsi_semantic coord_semantic =
+         fs->base.type == PIPE_SHADER_IR_NIR ? TGSI_SEMANTIC_TEXCOORD :
+                                               wide->sprite_coord_semantic;
 
       wide->num_texcoord_gen = 0;
 
@@ -251,7 +255,7 @@ widepoint_first_point(struct draw_stage *stage,
          const enum tgsi_semantic sn = fs->info.input_semantic_name[i];
          const unsigned si = fs->info.input_semantic_index[i];
 
-         if (sn == wide->sprite_coord_semantic) {
+         if (sn == coord_semantic) {
             /* Note that sprite_coord_enable is a bitfield of 32 bits. */
             if (si >= 32 || !(rast->sprite_coord_enable & (1 << si)))
                continue;
-- 
